# ============================================
# 同行实验室 · 环境变量示例
# 复制本文件为 .env.local，填入真实值。
# .env.local 已加入 .gitignore，不会被提交。
# ============================================

# ----- 评论系统（Giscus） -----
# 访问 https://giscus.app 获取以下 4 个值
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# ----- 邮件系统（Resend）-----
# 访问 https://resend.com/api-keys 获取 API Key
RESEND_API_KEY=
# 发件邮箱。Resend 免费账号只能用 onboarding@resend.dev 或已验证过的域名邮箱
RESEND_FROM_EMAIL=onboarding@resend.dev
# 收通知的邮箱（站长邮箱，新订阅会发到这里）
OWNER_EMAIL=hello@tonghanglab.com

# ----- 网站分析（可选）-----
# Umami: https://umami.is
NEXT_UMAMI_ID=

# ----- Stripe（Stage 2 才需要）-----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 4 个 Harness 的 Price ID
STRIPE_PRICE_DD_SKELETON=
STRIPE_PRICE_ONELINER_COMP=
STRIPE_PRICE_RESEARCH_DIGEST=
STRIPE_PRICE_SIGNAL_RADAR=
STRIPE_PRICE_MONTHLY_SUBSCRIPTION=